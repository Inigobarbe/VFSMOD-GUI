        <property name="styleSheet">
         <string notr="true">QLabel {
font-family: 'Georgia'; /* Cambiar la fuente a Arial */
font-size: 16px; /* Cambiar el tamaño de la fuente */
color: #000000; /* Color de texto (negro) */
}
QLineEdit {
font-family: 'Georgia'; /* Cambiar la fuente */
font-size: 14px; /* Cambiar el tamaño de la fuente */
color: #000000; /* Color del texto */
background-color: #f0f0f0; /* Opcional: cambiar el color de fondo del QLineEdit */
border: 1px solid #000000; /* Opcional: añadir un borde negro */
}

/* Cambiar la fuente y estilo de los QPushButton dentro del QStackedWidget */
QPushButton {
font-family: 'Georgia'; /* Cambiar la fuente */
font-size: 10px; /* Cambiar el tamaño de la fuente */
color: #000000; /* Color del texto (blanco) */
background-color: #7b8087  ; /* Fondo oscuro */
border: 1px solid #000000; /* Borde negro */
border-radius: 5px; /* Bordes redondeados */
padding: 5px; /* Espaciado interno */
}

/* Estilo cuando el mouse pasa sobre el botón */
QPushButton:hover {
color: #ffffff;
background-color: #9ea4ad  ;
}

/* Estilo cuando el botón es presionado */
QStackedWidget QPushButton:pressed {
background-color: #2b3a4a; /* Fondo más oscuro al presionar */
color: #ffffff; /* Cambiar el color del texto a rojo cuando se presiona */
}

</string>
